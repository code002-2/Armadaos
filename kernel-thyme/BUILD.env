# --- Xiaomi Mi 10S (thyme) kernel source --------------------------------------
# Armada's thyme variant does NOT use armada-packages' kernel.org build.
# It points straight at the community mainline tree that carries the
# sm8250-xiaomi-thyme board support: CSOT MP42020B DSC panel, ST FTS
# touchscreen, WCD938x + CS35L41 audio, SMB2 battery, SDX55 modem, camera
# (S5KHMX/S5K3T2/OV13B10) support, etc.
#
# KERNEL_SRC (optional): build from a local checkout instead of cloning —
# used on the porting workstation, where the tree carries uncommitted fixes.
KERNEL_REPO=https://github.com/yuweiyuan8/linux-xiaomi-thyme-mainline
KERNEL_BRANCH=master
KERNEL_CONFIG=sm8250.config

# Armada runtime fragments merged on top of the thyme base config (beyond
# what the thyme config already enables). The first entry is the Armada
# runtime; thyme-modem.config is the in-tree SDX55 modem fragment (resolved
# from the kernel tree when it does not exist in this directory).
KERNEL_OVERRIDES="thyme-armada.config.overrides thyme-modem.config"
